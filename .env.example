ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=locket_manager
# Six hexadecimal characters from your NextDNS dashboard; leave blank to disable downloads.
NEXTDNS_ID=
# Optional public root CA certificate (PEM or DER). Never supply a private key.
ROOT_CA_PATH=
